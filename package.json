{
  "name": "openapi-overlaykit",
  "version": "0.1.0",
  "description": "Apply OpenAPI Overlay 1.0.0 documents using a strict, RFC 9535-compliant JSONPath engine (no eval).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Hailong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hailong-am/openapi-overlaykit.git"
  },
  "bugs": {
    "url": "https://github.com/Hailong-am/openapi-overlaykit/issues"
  },
  "homepage": "https://github.com/Hailong-am/openapi-overlaykit#readme",
  "keywords": [
    "openapi",
    "overlay",
    "openapi-overlay",
    "oas",
    "jsonpath",
    "rfc9535",
    "swagger",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "openapi-overlaykit": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@swaggerexpert/jsonpath": "^4.0.5",
    "mergician": "^2.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
